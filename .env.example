# ================= MAX =================
# Токен бота MAX: создаётся в Master Bot (https://max.ru/masterbot).
# Никогда не коммить реальный токен — только через .env / CI secrets / платформу.
MAX_BOT_TOKEN=

# ================= Backend (Python / FastAPI) =================
# Порт HTTP (API ботов)
PORT=8080
# Каталог runtime-данных (для локального запуска вне Postgres)
DATA_DIR=./backend/data
# Demo-режим: true — вход без initData (заголовок x-user-id), false — строгая проверка подписи HMAC-SHA256
DEMO_MODE=true
# Разрешенные origin (CORS). "*" — любые.
CORS_ORIGIN=*
# Подключение к PostgreSQL. Внутри compose service `db` — postgresql+psycopg://sport:sport@db:5432/sport
DATABASE_URL=postgresql+psycopg://sport:sport@localhost:5432/sport

# ================= Админка организаторов =================
# Дефолтный организатор создаётся при первом старте бэкенда
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# Секрет подписи JWT-токенов (смените на свой)
ADMIN_JWT_SECRET=sport-nearby-dev-secret

# ================= Postgres =================
POSTGRES_PASSWORD=sport

# ================= Bot =================
# Период опроса напоминаний (мс)
BOT_POLL_INTERVAL_MS=60000
# URL backend для бота (внутри compose — http://backend:8080)
BACKEND_URL=http://localhost:8080